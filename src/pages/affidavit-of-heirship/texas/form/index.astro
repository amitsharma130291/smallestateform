const articleSchema = `{
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": "Texas Affidavit of Heirship Form: What It Looks Like and How to Complete It",
  "description": "No single Texas heirship affidavit form exists — here's what the document must include, how to fill it correctly, and the most common errors that invalidate it.",
  "datePublished": "2026-07-01",
  "dateModified": "2026-07-31",
  "author": {
    "@type": "Organization",
    "name": "smallestateform.com",
    "url": "https://smallestateform.com"
  },
  "publisher": {
    "@type": "Organization",
    "name": "smallestateform.com",
    "url": "https://smallestateform.com"
  }
}`;

const faqSchema = `{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Is there an official Texas state form for an Affidavit of Heirship?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No. Texas does not publish an official state form for real property Affidavits of Heirship. Texas Estates Code § 203.001 sets the legal requirements, but the document itself is practitioner-drafted. Any properly executed affidavit that meets the statutory requirements will be accepted by county clerks."
      }
    },
    {
      "@type": "Question",
      "name": "How many witnesses does a Texas Affidavit of Heirship require?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Two disinterested witnesses are required. Each witness must personally know the deceased and must have no financial interest in the estate — meaning they cannot be heirs, beneficiaries, or creditors. An affidavit with only one witness, or with a witness who is also an heir, does not satisfy Texas Estates Code § 203.001."
      }
    },
    {
      "@type": "Question",
      "name": "Can a family member be a witness on a Texas Affidavit of Heirship?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Only if that family member has no financial interest in the estate. A distant relative who will not inherit anything and who knew the deceased qualifies. A child, sibling, or surviving spouse who will inherit — or whose spouse will inherit — does not qualify as a disinterested witness."
      }
    },
    {
      "@type": "Question",
      "name": "Does a Texas Affidavit of Heirship need to be recorded?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. Recording with the county clerk in the county where the property is located is required to make the affidavit effective against third parties. An unrecorded affidavit may be accepted by some banks but provides no title protection for real property and will not satisfy a title company reviewing a future sale."
      }
    },
    {
      "@type": "Question",
      "name": "What property description is required on a Texas Affidavit of Heirship?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "The legal description from the deed — not a street address. The legal description typically appears on the existing deed and in the county appraisal district records. It must match the description in the deed records exactly."
      }
    },
    {
      "@type": "Question",
      "name": "How long does it take to complete a Texas Affidavit of Heirship?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Gathering the required information — marital history, children's names and addresses, legal property description, finding two qualifying witnesses — typically takes 1–2 weeks. Completing and notarizing the form takes another 1–3 days. Filing with the county clerk can be done the same day as notarization."
      }
    },
    {
      "@type": "Question",
      "name": "What is the filing fee for a Texas Affidavit of Heirship?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Major Texas counties charge $25 for the first page plus $4 per additional page. A typical affidavit runs 2–5 pages, putting the total filing fee at approximately $29–$41. Confirm current fees with the specific county clerk before filing."
      }
    }
  ]
}`;

