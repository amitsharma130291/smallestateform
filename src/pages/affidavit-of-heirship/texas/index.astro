    },
    {
      "@type": "HowToStep",
      "name": "Record with the county clerk",
      "text": "File the original notarized affidavit at the county clerk's deed records office in the county where the property is located. Pay the filing fee (approximately $25 for the first page)."
    },
    {
      "@type": "HowToStep",
      "name": "Obtain certified copies",
      "text": "Request certified copies from the county clerk after recording. Banks and title companies require certified copies — not photocopies — to accept the affidavit."
    }
