    "name": "smallestateform.com",
    "url": "https://smallestateform.com"
  }
}`;

const faqSchema = `{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Who qualifies as a disinterested witness for a Texas Affidavit of Heirship?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "A disinterested witness is someone who personally knew the deceased and has no financial interest in the estate. They cannot be heirs, beneficiaries, or anyone who owes money to the estate. Neighbors, former coworkers, family friends, and church members typically qualify."
      }
    },
    {
      "@type": "Question",
      "name": "Is there an asset value limit for a Texas Affidavit of Heirship?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No. Unlike a Small Estate Affidavit, there is no asset threshold for an Affidavit of Heirship in Texas. It can be used regardless of the estate's value."
      }
    },
    {
      "@type": "Question",
      "name": "Does a Texas Affidavit of Heirship need to be recorded?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. Recording with the county clerk's deed records is required to make the affidavit effective against third parties such as banks, title companies, and future buyers. An unrecorded affidavit provides no chain-of-title protection."
      }
    },
    {
      "@type": "Question",
      "name": "How long does it take to file an Affidavit of Heirship in Texas?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Gathering information and completing the form typically takes 1–2 weeks. Filing at the county clerk's office can be done same-day. If mailing, allow an additional 1–2 weeks for processing."
      }
    },
    {
      "@type": "Question",
      "name": "Can I use an Affidavit of Heirship for bank accounts in Texas?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Many banks accept a properly notarized and recorded Affidavit of Heirship for account access, especially for modest balances. Larger banks may require their own internal forms or a court order. A bank instruction letter citing legal authority improves acceptance rates."
      }
    },
    {
      "@type": "Question",
      "name": "What is the filing fee for an Affidavit of Heirship at the county clerk?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Major Texas counties charge $25 for the first page plus $4 for each additional page. Confirm the current fee with your specific county clerk before filing."
      }
    },
    {
      "@type": "Question",
      "name": "Do I need an attorney to file a Texas Affidavit of Heirship?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No. Texas law does not require an attorney to prepare or file an Affidavit of Heirship. However, consulting an attorney is advisable for complicated family situations, significant debts, or properties being sold soon."
      }
    },
    {
      "@type": "Question",
      "name": "What is the difference between a Texas Affidavit of Heirship and probate?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "An Affidavit of Heirship requires no court involvement and costs $25–$100 in filing fees. Formal probate requires a court proceeding, typically costs $3,000–$15,000+ in attorney fees, and takes 6–18 months. Probate offers stronger creditor protection and is better for contested estates."
      }
    }
  ]
}`;

const howToSchema = `{
  "@context": "https://schema.org",
  "@type": "HowTo",
  "name": "How to File an Affidavit of Heirship in Texas",
  "description": "Step-by-step process for completing, notarizing, and recording a Texas Affidavit of Heirship under Texas Estates Code Chapter 203.",
  "totalTime": "P14D",
  "estimatedCost": {
    "@type": "MonetaryAmount",
    "currency": "USD",
