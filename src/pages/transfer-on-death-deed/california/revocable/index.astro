const articleSchema = `{
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": "California Transfer on Death Deed: How Revocability Works and How to Revoke One",
  "description": "California's TOD deed is 100% revocable until death. Learn how to revoke it, what doesn't revoke it (marriage, divorce, a new will), and how revocability protects you.",
  "datePublished": "2026-07-01",
  "dateModified": "2026-07-31",
  "author": {
    "@type": "Organization",
    "name": "smallestateform.com",
    "url": "https://smallestateform.com"
  },
  "publisher": {
    "@type": "Organization",
    "name": "smallestateform.com",
    "url": "https://smallestateform.com"
  }
}`;

const faqSchema = `{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Is a California Transfer on Death Deed revocable?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. Under California Probate Code § 5600, a TOD deed is completely revocable at any time before the grantor's death. The grantor retains full ownership and control of the property during their lifetime. The deed has no legal effect until death."
      }
    },
    {
      "@type": "Question",
      "name": "How do I revoke a California Transfer on Death Deed?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Record a Revocation of Transfer on Death Deed with the county recorder in the county where the property is located, before your death. The revocation must be notarized and recorded — an unrecorded revocation has no legal effect. Alternatively, record a new TOD deed naming different beneficiaries, which automatically supersedes the earlier one."
      }
    },
    {
      "@type": "Question",
      "name": "Does a new will override a California TOD deed?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No. A California TOD deed operates independently of any will. The deed controls disposition of the specific real property it covers regardless of what a will says. To change the beneficiary, you must record a revocation or a new TOD deed — a will provision purporting to override the deed is legally ineffective."
      }
    },
    {
      "@type": "Question",
      "name": "Does selling the property revoke a California TOD deed?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Not automatically. If a sale closes and title transfers to a buyer, the TOD deed becomes practically moot because the grantor no longer owns the property. But the deed remains in the public record. To be safe, record a formal revocation as part of any sale transaction. Title companies often require this as a condition of closing."
      }
    },
    {
      "@type": "Question",
      "name": "Does divorce revoke a California TOD deed naming an ex-spouse?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Not automatically. Divorce alone does not revoke a recorded TOD deed in California. If the deed names an ex-spouse and you do not record a formal revocation after divorce, the ex-spouse may still receive the property at your death. Always review and update TOD deeds after a divorce."
      }
    },
    {
      "@type": "Question",
      "name": "What is the 120-day period after death for a California TOD deed?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Under California Probate Code § 5696, the 120-day period after the grantor's death is the window during which creditors of the estate, a surviving spouse, and other interested parties may assert claims against the property. After 120 days, the beneficiary can record an Affidavit of Death to formally take title."
      }
    },
    {
      "@type": "Question",
      "name": "Does marriage revoke a California TOD deed?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No. A subsequent marriage does not automatically revoke a previously recorded California TOD deed. If you marry after recording a TOD deed, the deed remains in effect with its original beneficiary unless you record a revocation or a new deed. Review and update estate planning documents after any major life change."
      }
    }
  ]
}`;

const breadcrumbSchema = `{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
