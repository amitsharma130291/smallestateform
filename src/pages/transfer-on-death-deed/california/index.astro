---
import StatePage from '../../../layouts/StatePage.astro';
import AffidavitFormApp from '../../../components/AffidavitFormApp';

const articleSchema = `{
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": "California Transfer on Death Deed: Complete Guide (2026)",
  "description": "California Transfer on Death Deed avoids probate for real property under Civil Code §5600–5696. How to complete, record, and revoke a CA TOD Deed. Fees by county.",
  "datePublished": "2026-01-01",
  "dateModified": "2026-07-28",
  "author": {
    "@type": "Organization",
    "name": "smallestateform.com",
    "url": "https://smallestateform.com"
  },
  "publisher": {
    "@type": "Organization",
    "name": "smallestateform.com",
    "url": "https://smallestateform.com"
  }
}`;

const faqSchema = `{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What is a California Transfer on Death Deed?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "A California Transfer on Death Deed (TOD Deed) is a revocable document that transfers real property to a named beneficiary automatically at the owner's death, without probate. It is authorized under California Civil Code §5600–5696 and became operative on January 1, 2022 under AB 1052."
      }
    },
    {
      "@type": "Question",
      "name": "What is an APN and where do I find it for a California TOD Deed?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "An APN (Assessor's Parcel Number) is a unique identifier assigned to real property by the county tax assessor. It appears on your property tax bill and can be found on the county assessor's website using your property address. It is required on the California TOD Deed to ensure it is recorded against the correct property."
      }
    },
    {
      "@type": "Question",
      "name": "Can I have multiple beneficiaries on a California TOD Deed?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. Multiple beneficiaries take the property as tenants in common with equal shares unless you specify percentages. You can also name alternate beneficiaries who receive the property if a primary beneficiary dies before you."
      }
    },
    {
      "@type": "Question",
      "name": "Does a California TOD Deed override a will?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Generally, yes — for the specific property covered by the TOD Deed. The deed controls disposition of that real property regardless of what a will says about it. If you change your intentions, you must revoke the TOD Deed by recording a revocation deed."
      }
    },
    {
      "@type": "Question",
      "name": "How do I revoke a California Transfer on Death Deed?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Complete a revocation deed, sign it before a notary public, and record it with the county recorder in the county where the property is located. An unrecorded revocation has no legal effect — the property will still transfer to the named beneficiary at death."
      }
    },
    {
      "@type": "Question",
      "name": "What are the county recorder fees for a California TOD Deed?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Recording fees vary by county. In 2026, the per-page fee is approximately $21 in Los Angeles, San Diego, Orange, and Riverside counties, and $15 per page in San Francisco. Most TOD Deeds are 2–3 pages."
      }
    }
  ]
}`;

const howToSchema = `{
  "@context": "https://schema.org",
  "@type": "HowTo",
  "name": "How to Complete and Record a California Transfer on Death Deed",
  "description": "Step-by-step guide to setting up a revocable Transfer on Death Deed for California real property under Civil Code §5600–5696.",
  "totalTime": "P7D",
  "estimatedCost": {
    "@type": "MonetaryAmount",
    "currency": "USD",
    "value": "42"
  },
  "step": [
    {
      "@type": "HowToStep",
      "name": "Gather property information",
      "text": "Collect the legal description of the property from the current deed and the Assessor's Parcel Number (APN) from your property tax bill or the county assessor's website."
    },
    {
      "@type": "HowToStep",
      "name": "Name your beneficiary",
      "text": "Enter the full legal name of your beneficiary. Optionally name an alternate beneficiary who takes the property if your primary beneficiary predeceases you."
    },
    {
      "@type": "HowToStep",
      "name": "Complete the TOD Deed form",
      "text": "Fill in the grantor's full legal name, beneficiary name(s), property legal description, and APN."
    },
    {
      "@type": "HowToStep",
      "name": "Sign before a notary public",
      "text": "The grantor (property owner) must sign the completed TOD Deed in the presence of a notary public. The beneficiary does not need to sign."
    },
    {
      "@type": "HowToStep",
      "name": "Record with the county recorder within 60 days",
      "text": "File the notarized TOD Deed with the county recorder in the county where the property is located. Recording must occur within 60 days of notarization. Pay the per-page recording fee."
    }
  ]
}`;

const breadcrumbSchema = `{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "https://smallestateform.com/"
    },
    {
      "@type": "ListItem",
      "position": 2,
