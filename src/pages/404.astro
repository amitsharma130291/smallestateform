---
export const prerender = true;
import StatePage from '../layouts/StatePage.astro';
---
<StatePage
  title="Page Not Found | Small Estate Form"
  description="The page you are looking for could not be found. Return to SmallEstateForm.com to generate estate documents."
>
  <section style="padding:8rem 1.5rem 6rem;background:#F7F4EF;min-height:60vh;display:flex;align-items:center;">
    <div style="max-width:560px;margin:0 auto;text-align:center;">
      <p style="font-family:'Cormorant Garamond',Georgia,serif;font-style:italic;font-size:6rem;color:#B8860B;margin:0 0 0.5rem;line-height:1;">404</p>
      <h1 style="font-family:'Cormorant Garamond',Georgia,serif;font-style:italic;font-size:clamp(1.75rem,4vw,2.4rem);color:#1C1C1E;margin-bottom:1rem;">Page Not Found</h1>
      <p style="font-family:'DM Sans',sans-serif;color:#6B6560;font-size:1rem;line-height:1.7;margin-bottom:2.5rem;">
        Sorry, we could not find the page you were looking for. It may have been moved or removed.
      </p>
      <div style="display:flex;gap:1rem;justify-content:center;flex-wrap:wrap;">
        <a href="/"
          style="display:inline-block;background:#1C3A0E;color:#FAF8F5;font-family:'DM Sans',sans-serif;font-size:0.95rem;font-weight:500;padding:0.8rem 1.75rem;border-radius:6px;text-decoration:none;">
          Go to Homepage
        </a>
        <a href="/contact/"
          style="display:inline-block;background:transparent;color:#1C3A0E;font-family:'DM Sans',sans-serif;font-size:0.95rem;font-weight:500;padding:0.8rem 1.75rem;border-radius:6px;text-decoration:none;border:1.5px solid #1C3A0E;">
          Contact Support
        </a>
      </div>
    </div>
  </section>
</StatePage>
