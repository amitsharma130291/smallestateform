---
import StatePage from '../../layouts/StatePage.astro';

const faqSchema = `{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What is a small estate affidavit?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "A small estate affidavit is a sworn legal document that allows heirs to collect a deceased person's assets — such as bank accounts, vehicles, or personal property — without opening a formal probate case. It is available in most states when the estate's total value falls below a state-specific threshold. The heir signs the document, has it notarized, and presents it to the asset holder, who is authorized to release the assets without a court order."
      }
    },
    {
      "@type": "Question",
      "name": "What are the small estate affidavit thresholds by state in 2026?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "2026 thresholds: California $239,700 (personal property, deaths after April 1, 2026); Arizona $200,000 personal / $300,000 real property (HB2116, March 2026); Illinois $150,000 statewide / Cook County $20,000 + $10,000/minor child (August 2025); Texas $75,000 personal property (Affidavit of Heirship has no threshold for real property); Colorado $80,000; Washington $100,000; Nevada $100,000; Oregon $275,000; New York $50,000; Florida $75,000."
      }
    },
    {
      "@type": "Question",
      "name": "How long does a small estate affidavit take?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Most states require a 30-day waiting period after death. After that, completing the form takes 1–2 hours and filing takes one visit or mail submission. Total time from death to asset access is typically 5–8 weeks for straightforward estates."
      }
    },
    {
      "@type": "Question",
      "name": "Does a small estate affidavit work for real estate?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "It depends on the state. Arizona allows it for real property under $300,000 (HB2116). Nevada allows it for real property under $100,000. Illinois and California do not cover real estate through the small estate affidavit process. Texas uses an Affidavit of Heirship for real property with no asset threshold."
      }
    },
    {
      "@type": "Question",
      "name": "Do I need an attorney for a small estate affidavit?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No. The process is designed to be used without attorney involvement. For straightforward estates below the threshold with clear heirs, most families complete it without legal help. Attorney involvement is advisable for complicated estates, significant debts, or disputed heirs."
      }
    },
    {
      "@type": "Question",
      "name": "What is the difference between a small estate affidavit and probate?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "A small estate affidavit bypasses probate court entirely. It is a sworn document presented directly to asset holders (banks, DMV, county recorder). Probate is a formal court process that can take 9–18+ months and cost $3,000–$30,000+. Small estate affidavits are available only for estates below a state-specific threshold."
      }
    },
    {
      "@type": "Question",
      "name": "Does a small estate affidavit work for bank accounts?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes, for most bank accounts without a payable-on-death designation. Present the notarized affidavit with a death certificate and photo ID. Banks are authorized — and in many states legally required — to honor a properly prepared affidavit. A bank instruction letter citing the applicable statute improves cooperation significantly."
      }
    },
    {
      "@type": "Question",
      "name": "What is the difference between a small estate affidavit and an affidavit of heirship?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "A small estate affidavit is used to collect specific assets when the estate is under a threshold. An affidavit of heirship (used primarily in Texas) establishes the identity of heirs for real property succession — it has no asset threshold but requires two disinterested witnesses and must be recorded with the county clerk."
      }
    }
  ]
}`;

const articleSchema = `{
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": "Small Estate Affidavit: Complete Guide for Every State (2026)",
  "description": "Comprehensive guide to small estate affidavits: how they work, current 2026 thresholds by state, when to use them vs. probate, and step-by-step process.",
  "datePublished": "2026-01-01",
  "dateModified": "2026-07-28",
  "author": {
    "@type": "Organization",
    "name": "smallestateform.com",
    "url": "https://smallestateform.com"
  },
  "publisher": {
    "@type": "Organization",
    "name": "smallestateform.com",
    "url": "https://smallestateform.com"
  }
}`;

const breadcrumbSchema = `{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "https://smallestateform.com/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Small Estate Affidavit",
      "item": "https://smallestateform.com/small-estate-affidavit/"
    }
  ]
}`;
---

<StatePage
  title="Small Estate Affidavit: Complete Guide for Every State (2026)"
  description="What is a small estate affidavit, how it works, and current 2026 thresholds for every major state. Skip probate when the estate qualifies. Updated July 2026."
  canonicalUrl="https://smallestateform.com/small-estate-affidavit/"
  jsonLd={[faqSchema, articleSchema, breadcrumbSchema]}
>

  <!-- Featured snippet callout -->
  <div class="bg-[#EEE9E1] border-l-4 border-[#8B6914] p-6 mb-0 mt-8 max-w-4xl mx-auto">
    <p class="font-medium text-[#2D5016] leading-relaxed">
      A small estate affidavit is a sworn legal document that allows heirs to collect a deceased person's assets — bank accounts, property, vehicles — without opening a probate case in court. It is available in most states when the estate's total value falls below a state-specific threshold, which ranges from $20,000 to $300,000+ depending on the state.
    </p>
  </div>

  <!-- E-E-A-T disclaimer -->
  <div class="bg-[#F7F4EF] border border-[#D4CCC0] rounded-lg p-4 mb-0 max-w-4xl mx-auto mt-4 text-sm text-[#6B6560]">
    <strong class="text-[#2C2C2A]">Legal information, not legal advice.</strong> Thresholds and procedures change frequently. Figures on this page reflect law as of July 2026. Consult a licensed attorney for advice specific to your situation.
  </div>

  <!-- Main content -->
  <div class="max-w-4xl mx-auto px-6 py-12">

    <h1 class="italic font-serif text-4xl text-[#2D5016] mb-8 leading-tight">Small Estate Affidavit: What It Is, How It Works, and Current Thresholds by State</h1>

    <!-- What is it -->
    <section class="mb-12">
      <h2 class="font-serif text-2xl text-[#2D5016] mb-4">What Is a Small Estate Affidavit?</h2>
      <p class="text-[#2C2C2A] leading-relaxed mb-4">
        A small estate affidavit is a sworn legal document that allows an heir to collect a deceased person's assets without opening a formal probate estate. The heir signs the document, has it notarized, and presents it to whoever holds the assets — a bank, a brokerage, the DMV, or a county recorder — rather than going through a court proceeding.
      </p>
      <p class="text-[#2C2C2A] leading-relaxed mb-4">
        Most states have created this process specifically because formal probate is expensive and slow relative to the size of many modest estates. An estate worth $80,000 does not need $10,000 in probate attorney fees and 12 months of waiting before the family can access it.
      </p>
      <p class="text-[#2C2C2A] leading-relaxed mb-4">The affidavit works because the heir swears under oath to certain facts:</p>
      <ul class="list-disc list-inside text-[#2C2C2A] space-y-2 mb-4 pl-4">
        <li>The deceased has died</li>
        <li>There is no pending probate proceeding</li>
        <li>The required waiting period has elapsed</li>
        <li>The estate falls within the applicable threshold</li>
        <li>The affiant is a legitimate heir</li>
      </ul>
      <p class="text-[#2C2C2A] leading-relaxed">
        The asset holder then has legal authority — and in many states, legal obligation — to release the assets based on that sworn statement.
      </p>
    </section>

    <!-- How it works in practice -->
    <section class="mb-12">
      <h2 class="font-serif text-2xl text-[#2D5016] mb-4">How a Small Estate Affidavit Works in Practice</h2>
      <ol class="space-y-3 text-[#2C2C2A]">
        <li class="flex gap-3"><span class="text-[#8B6914] font-bold text-lg leading-tight">1.</span><span><strong>A person dies</strong> — with or without a will</span></li>
        <li class="flex gap-3"><span class="text-[#8B6914] font-bold text-lg leading-tight">2.</span><span><strong>The family identifies assets</strong> — bank accounts, a car, personal property, sometimes real estate</span></li>
        <li class="flex gap-3"><span class="text-[#8B6914] font-bold text-lg leading-tight">3.</span><span><strong>They calculate the estate value</strong> to determine if it's under their state's threshold</span></li>
        <li class="flex gap-3"><span class="text-[#8B6914] font-bold text-lg leading-tight">4.</span><span><strong>They wait the required period</strong> (30–45 days in most states)</span></li>
        <li class="flex gap-3"><span class="text-[#8B6914] font-bold text-lg leading-tight">5.</span><span><strong>They complete and notarize the affidavit</strong></span></li>
        <li class="flex gap-3"><span class="text-[#8B6914] font-bold text-lg leading-tight">6.</span><span><strong>They present it</strong> to the bank, DMV, or county recorder</span></li>
        <li class="flex gap-3"><span class="text-[#8B6914] font-bold text-lg leading-tight">7.</span><span><strong>The assets transfer</strong> without a judge, without a lawyer, without months of waiting</span></li>
      </ol>
      <p class="text-[#2C2C2A] leading-relaxed mt-4">
        The entire process can take as little as a few weeks from death to asset access in straightforward cases. Formal probate in the same state might take 9–18 months.
      </p>
    </section>

    <!-- Comparison table -->
    <section class="mb-12">
      <h2 class="font-serif text-2xl text-[#2D5016] mb-6">Small Estate Affidavit vs. Full Probate</h2>
      <div class="overflow-x-auto">
        <table class="w-full border-collapse text-sm">
          <thead>
            <tr class="bg-[#2D5016] text-[#F7F4EF]">
              <th class="p-3 text-left">Factor</th>
              <th class="p-3 text-left">Small Estate Affidavit</th>
              <th class="p-3 text-left">Full Probate</th>
            </tr>
          </thead>
          <tbody>
            <tr class="border-b border-[#D4CCC0]">
              <td class="p-3 font-medium text-[#2D5016]">Estate value</td>
              <td class="p-3 text-[#2C2C2A]">Below state threshold</td>
              <td class="p-3 text-[#2C2C2A]">Any size</td>
            </tr>
            <tr class="border-b border-[#D4CCC0] bg-[#F7F4EF]">
              <td class="p-3 font-medium text-[#2D5016]">Court involvement</td>
              <td class="p-3 text-[#2C2C2A]">None</td>
              <td class="p-3 text-[#2C2C2A]">Required</td>
            </tr>
            <tr class="border-b border-[#D4CCC0]">
              <td class="p-3 font-medium text-[#2D5016]">Attorney needed</td>
              <td class="p-3 text-[#2C2C2A]">Usually not</td>
              <td class="p-3 text-[#2C2C2A]">Strongly recommended</td>
            </tr>
            <tr class="border-b border-[#D4CCC0] bg-[#F7F4EF]">
              <td class="p-3 font-medium text-[#2D5016]">Cost</td>
              <td class="p-3 text-[#2C2C2A]">Filing fees ($0–$50+)</td>
              <td class="p-3 text-[#2C2C2A]">$3,000–$30,000+</td>
            </tr>
            <tr class="border-b border-[#D4CCC0]">
              <td class="p-3 font-medium text-[#2D5016]">Time</td>
              <td class="p-3 text-[#2C2C2A]">Weeks</td>
              <td class="p-3 text-[#2C2C2A]">9–18+ months</td>
            </tr>
            <tr class="border-b border-[#D4CCC0] bg-[#F7F4EF]">
              <td class="p-3 font-medium text-[#2D5016]">Best for</td>
              <td class="p-3 text-[#2C2C2A]">Clear heirs, straightforward assets</td>
              <td class="p-3 text-[#2C2C2A]">Contested estates, large debts, complex assets</td>
            </tr>
            <tr class="border-b border-[#D4CCC0]">
              <td class="p-3 font-medium text-[#2D5016]">Works for real property</td>
              <td class="p-3 text-[#2C2C2A]">Depends on state</td>
              <td class="p-3 text-[#2C2C2A]">Yes</td>
            </tr>
          </tbody>
        </table>
      </div>
      <div class="mt-6 bg-[#F7F4EF] border border-[#D4CCC0] rounded-lg p-4 text-sm text-[#2C2C2A]">
        <strong>When to choose probate instead:</strong> The estate significantly exceeds the state threshold; there are disputed heirs or a contested will; the estate has significant unpaid debts or creditor claims; real estate is involved and your state's small estate affidavit doesn't cover real property; the family cannot agree on who the heirs are.
      </div>
    </section>

    <!-- State thresholds table -->
    <section class="mb-12">
      <h2 class="font-serif text-2xl text-[#2D5016] mb-6">Current Small Estate Thresholds by State (Updated July 2026)</h2>
      <div class="overflow-x-auto">
        <table class="w-full border-collapse text-sm">
          <thead>
            <tr class="bg-[#2D5016] text-[#F7F4EF]">
              <th class="p-3 text-left">State</th>
              <th class="p-3 text-left">Personal Property Limit</th>
              <th class="p-3 text-left">Real Property Limit</th>
              <th class="p-3 text-left">Waiting Period</th>
              <th class="p-3 text-left">Notes</th>
            </tr>
          </thead>
          <tbody>
            <tr class="border-b border-[#D4CCC0]">
              <td class="p-3 font-medium text-[#2D5016]">California</td>
              <td class="p-3 text-[#2C2C2A]">$239,700</td>
              <td class="p-3 text-[#2C2C2A]">N/A (use TOD Deed)</td>
              <td class="p-3 text-[#2C2C2A]">40 days</td>
              <td class="p-3 text-[#2C2C2A]">Deaths after April 1, 2026</td>
            </tr>
            <tr class="border-b border-[#D4CCC0] bg-[#F7F4EF]">
              <td class="p-3 font-medium text-[#2D5016]">Arizona</td>
              <td class="p-3 text-[#2C2C2A]">$200,000</td>
              <td class="p-3 text-[#2C2C2A]">$300,000</td>
              <td class="p-3 text-[#2C2C2A]">30 days</td>
              <td class="p-3 text-[#8B6914] font-medium">Updated March 2026 — HB2116</td>
            </tr>
            <tr class="border-b border-[#D4CCC0]">
              <td class="p-3 font-medium text-[#2D5016]">Illinois</td>
              <td class="p-3 text-[#2C2C2A]">$150,000</td>
              <td class="p-3 text-[#2C2C2A]">N/A (probate for real property)</td>
              <td class="p-3 text-[#2C2C2A]">30 days</td>
              <td class="p-3 text-[#8B6914] font-medium">Updated August 2025; Cook County: $20,000 + $10,000/minor child</td>
            </tr>
            <tr class="border-b border-[#D4CCC0] bg-[#F7F4EF]">
              <td class="p-3 font-medium text-[#2D5016]">Texas</td>
              <td class="p-3 text-[#2C2C2A]">$75,000</td>
              <td class="p-3 text-[#2C2C2A]">N/A (use Affidavit of Heirship)</td>
              <td class="p-3 text-[#2C2C2A]">None</td>
              <td class="p-3 text-[#2C2C2A]">Affidavit of Heirship has no threshold</td>
            </tr>
            <tr class="border-b border-[#D4CCC0]">
              <td class="p-3 font-medium text-[#2D5016]">Oregon</td>
              <td class="p-3 text-[#2C2C2A]">$275,000</td>
              <td class="p-3 text-[#2C2C2A]">N/A</td>
              <td class="p-3 text-[#2C2C2A]">30 days</td>
              <td class="p-3 text-[#2C2C2A]">Among the highest personal property limits</td>
            </tr>
            <tr class="border-b border-[#D4CCC0] bg-[#F7F4EF]">
              <td class="p-3 font-medium text-[#2D5016]">Nevada</td>
              <td class="p-3 text-[#2C2C2A]">$100,000</td>
              <td class="p-3 text-[#2C2C2A]">$100,000</td>
              <td class="p-3 text-[#2C2C2A]">40 days</td>
              <td class="p-3 text-[#2C2C2A]">Covers both personal and real property</td>
            </tr>
            <tr class="border-b border-[#D4CCC0]">
              <td class="p-3 font-medium text-[#2D5016]">Washington</td>
              <td class="p-3 text-[#2C2C2A]">$100,000</td>
              <td class="p-3 text-[#2C2C2A]">N/A</td>
              <td class="p-3 text-[#2C2C2A]">40 days</td>
              <td class="p-3 text-[#2C2C2A]">Personal property only</td>
            </tr>
            <tr class="border-b border-[#D4CCC0] bg-[#F7F4EF]">
              <td class="p-3 font-medium text-[#2D5016]">Colorado</td>
              <td class="p-3 text-[#2C2C2A]">$80,000</td>
              <td class="p-3 text-[#2C2C2A]">$80,000</td>
              <td class="p-3 text-[#2C2C2A]">10 days</td>
              <td class="p-3 text-[#2C2C2A]">Shortest waiting period</td>
            </tr>
            <tr class="border-b border-[#D4CCC0]">
              <td class="p-3 font-medium text-[#2D5016]">Florida</td>
              <td class="p-3 text-[#2C2C2A]">$75,000</td>
              <td class="p-3 text-[#2C2C2A]">N/A</td>
              <td class="p-3 text-[#2C2C2A]">30 days</td>
              <td class="p-3 text-[#2C2C2A]">Summary administration available</td>
            </tr>
            <tr class="border-b border-[#D4CCC0] bg-[#F7F4EF]">
              <td class="p-3 font-medium text-[#2D5016]">New York</td>
              <td class="p-3 text-[#2C2C2A]">$50,000</td>
              <td class="p-3 text-[#2C2C2A]">N/A</td>
              <td class="p-3 text-[#2C2C2A]">30 days</td>
              <td class="p-3 text-[#2C2C2A]">Voluntary administration; no real estate</td>
            </tr>
          </tbody>
        </table>
      </div>
      <p class="text-sm text-[#6B6560] mt-3">Thresholds change. Always verify the current threshold for your state before proceeding.</p>
    </section>

    <!-- State-specific pages section -->
    <section class="mb-12">
      <h2 class="font-serif text-2xl text-[#2D5016] mb-6">State-Specific Pages: Current Law and Document Generators</h2>

      <!-- Arizona -->
      <div class="border border-[#D4CCC0] rounded-xl p-6 mb-6 bg-[#F7F4EF]">
        <div class="flex items-start justify-between gap-4 mb-3">
          <h3 class="font-serif text-xl text-[#2D5016]">Arizona Small Estate Affidavit (HB2116, March 2026)</h3>
          <span class="bg-[#FFF8E8] border border-[#8B6914] text-[#8B6914] text-xs font-medium px-2 py-1 rounded whitespace-nowrap">Updated 2026</span>
        </div>
        <p class="text-[#2C2C2A] text-sm leading-relaxed mb-4">
          Arizona raised its limits dramatically in March 2026 under HB2116: personal property to $200,000 and real property to $300,000 — some of the highest limits in the country. The 30-day waiting period applies statewide. Maricopa, Pima, and Yavapai counties use county-specific forms.
        </p>
        <div class="flex gap-4 text-sm">
          <a href="/small-estate-affidavit/arizona/" class="text-[#8B6914] hover:underline font-medium">Arizona Full Guide →</a>
          <a href="/small-estate-affidavit/arizona/maricopa/" class="text-[#8B6914] hover:underline font-medium">Maricopa County →</a>
        </div>
      </div>

      <!-- Illinois -->
      <div class="border border-[#D4CCC0] rounded-xl p-6 mb-6 bg-[#F7F4EF]">
        <div class="flex items-start justify-between gap-4 mb-3">
          <h3 class="font-serif text-xl text-[#2D5016]">Illinois Small Estate Affidavit (Amended August 2025)</h3>
          <span class="bg-[#FFF8E8] border border-[#8B6914] text-[#8B6914] text-xs font-medium px-2 py-1 rounded whitespace-nowrap">Updated 2025</span>
        </div>
        <p class="text-[#2C2C2A] text-sm leading-relaxed mb-4">
          Illinois raised its statewide threshold to $150,000 in August 2025. Cook County is different: the limit is $20,000 plus $10,000 per surviving minor child. The Illinois Secretary of State PDF that ranks highly on Google is from 2015. Do not use it.
        </p>
        <a href="/small-estate-affidavit/illinois/" class="text-[#8B6914] hover:underline font-medium text-sm">Illinois Full Guide →</a>
      </div>

      <!-- Texas -->
      <div class="border border-[#D4CCC0] rounded-xl p-6 mb-6 bg-[#F7F4EF]">
        <h3 class="font-serif text-xl text-[#2D5016] mb-3">Texas Affidavit of Heirship</h3>
        <p class="text-[#2C2C2A] text-sm leading-relaxed mb-4">
          Texas handles property transfers differently from most states. For real property, the primary tool is the Affidavit of Heirship (Texas Estates Code Chapter 203), which has <strong>no asset threshold</strong> — it can be used for a ranch worth millions or a lot worth $50,000. Requires two disinterested witnesses and must be recorded with the county clerk.
        </p>
        <a href="/affidavit-of-heirship/texas/" class="text-[#8B6914] hover:underline font-medium text-sm">Texas Affidavit of Heirship Guide →</a>
      </div>

      <!-- California -->
      <div class="border border-[#D4CCC0] rounded-xl p-6 mb-6 bg-[#F7F4EF]">
        <h3 class="font-serif text-xl text-[#2D5016] mb-3">California Transfer on Death Deed</h3>
        <p class="text-[#2C2C2A] text-sm leading-relaxed mb-4">
          California's threshold for personal property stands at $239,700 for deaths after April 1, 2026. For real property, California does not have a small estate affidavit process; instead, homeowners should consider a Transfer on Death Deed (Civil Code §5600–5696), which transfers property automatically at death without probate. Cost: only the county recorder's filing fee.
        </p>
        <a href="/transfer-on-death-deed/california/" class="text-[#8B6914] hover:underline font-medium text-sm">California TOD Deed Guide →</a>
      </div>
    </section>

    <!-- How to qualify -->
    <section class="mb-12">
      <h2 class="font-serif text-2xl text-[#2D5016] mb-6">How to Determine If You Qualify</h2>

      <div class="space-y-4">
        <div class="flex gap-4 p-4 bg-[#EEE9E1] rounded-lg border border-[#D4CCC0]">
          <div class="w-8 h-8 bg-[#2D5016] text-[#F7F4EF] rounded-full flex items-center justify-center font-serif text-sm shrink-0 mt-0.5">1</div>
          <div>
            <strong class="text-[#2D5016]">Has the waiting period elapsed?</strong>
            <p class="text-[#2C2C2A] text-sm mt-1">Most states require 30 days. Some require 40 days. Colorado requires as little as 10 days. Check your state's requirement.</p>
          </div>
        </div>
        <div class="flex gap-4 p-4 bg-[#EEE9E1] rounded-lg border border-[#D4CCC0]">
          <div class="w-8 h-8 bg-[#2D5016] text-[#F7F4EF] rounded-full flex items-center justify-center font-serif text-sm shrink-0 mt-0.5">2</div>
          <div>
            <strong class="text-[#2D5016]">What are the assets?</strong>
            <p class="text-[#2C2C2A] text-sm mt-1">List all assets. Exclude life insurance with named beneficiaries, retirement accounts with beneficiaries, jointly-held property, and payable-on-death bank accounts. What remains is the "probate estate."</p>
          </div>
        </div>
        <div class="flex gap-4 p-4 bg-[#EEE9E1] rounded-lg border border-[#D4CCC0]">
          <div class="w-8 h-8 bg-[#2D5016] text-[#F7F4EF] rounded-full flex items-center justify-center font-serif text-sm shrink-0 mt-0.5">3</div>
          <div>
            <strong class="text-[#2D5016]">What is the total value?</strong>
            <p class="text-[#2C2C2A] text-sm mt-1">Add up the probate estate. If it's under your state's threshold, you likely qualify.</p>
          </div>
        </div>
        <div class="flex gap-4 p-4 bg-[#EEE9E1] rounded-lg border border-[#D4CCC0]">
          <div class="w-8 h-8 bg-[#2D5016] text-[#F7F4EF] rounded-full flex items-center justify-center font-serif text-sm shrink-0 mt-0.5">4</div>
          <div>
            <strong class="text-[#2D5016]">What type of property is involved?</strong>
            <p class="text-[#2C2C2A] text-sm mt-1">Some states cover personal property only. Others also cover real property. Check whether your state's affidavit covers the specific type of asset you need to access.</p>
          </div>
        </div>
        <div class="flex gap-4 p-4 bg-[#EEE9E1] rounded-lg border border-[#D4CCC0]">
          <div class="w-8 h-8 bg-[#2D5016] text-[#F7F4EF] rounded-full flex items-center justify-center font-serif text-sm shrink-0 mt-0.5">5</div>
          <div>
            <strong class="text-[#2D5016]">Is probate already open?</strong>
            <p class="text-[#2C2C2A] text-sm mt-1">If someone has already filed a probate petition for this estate, the small estate affidavit process is generally not available.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Bank instruction letter -->
    <section class="mb-12">
      <h2 class="font-serif text-2xl text-[#2D5016] mb-4">The Bank Instruction Letter: Why It Matters</h2>
      <p class="text-[#2C2C2A] leading-relaxed mb-4">
        The single most common complaint from families using small estate affidavits is that the bank refuses to cooperate. A branch employee who has never seen the form before may say "we need a court order" — even when the law does not require one.
      </p>
      <p class="text-[#2C2C2A] leading-relaxed mb-4">
        The most effective remedy is a <strong>bank instruction letter</strong>: a document that cites the specific statute, explains the bank's legal authority to release the funds, and notes their potential liability for refusing a legally sufficient affidavit.
      </p>
      <div class="bg-[#EEE9E1] border-l-4 border-[#8B6914] p-5 rounded-r-lg">
        <p class="text-[#2C2C2A] text-sm leading-relaxed">
          Every document generated by smallestateform.com includes this letter. It is the feature most families notice most in practice — the difference between walking out with access to the account and walking out told to come back with a lawyer.
        </p>
      </div>
    </section>

  </div>

  <!-- FAQ -->
  <section class="max-w-4xl mx-auto px-6 pb-16">
    <h2 class="font-serif text-2xl text-[#2D5016] mb-8">Frequently asked questions</h2>
    <div class="space-y-4">

      <details class="bg-[#EEE9E1] rounded-xl border border-[#D4CCC0]">
        <summary class="p-6 font-medium text-[#2D5016] cursor-pointer list-none flex items-center justify-between">
          What is a small estate affidavit and how does it work?
          <span class="text-[#8B6914] text-xl">+</span>
        </summary>
        <div class="px-6 pb-6 text-[#2C2C2A] leading-relaxed text-sm">
          A small estate affidavit is a sworn legal document that allows heirs to collect a deceased person's assets without probate, when the estate's value falls below a state-specific threshold. The heir signs the document before a notary and presents it to the asset holder (bank, DMV, etc.), who is authorized to release the assets without a court order.
        </div>
      </details>

      <details class="bg-[#EEE9E1] rounded-xl border border-[#D4CCC0]">
        <summary class="p-6 font-medium text-[#2D5016] cursor-pointer list-none flex items-center justify-between">
          What happens if the estate is over the threshold?
          <span class="text-[#8B6914] text-xl">+</span>
        </summary>
        <div class="px-6 pb-6 text-[#2C2C2A] leading-relaxed text-sm">
          Formal probate is generally required. In some states, there are intermediate options — California has a simplified probate procedure for estates under $500,000; some states have summary administration. Consult an attorney if the estate exceeds the small estate threshold.
        </div>
      </details>

      <details class="bg-[#EEE9E1] rounded-xl border border-[#D4CCC0]">
        <summary class="p-6 font-medium text-[#2D5016] cursor-pointer list-none flex items-center justify-between">
          Does a small estate affidavit work for bank accounts?
          <span class="text-[#8B6914] text-xl">+</span>
        </summary>
        <div class="px-6 pb-6 text-[#2C2C2A] leading-relaxed text-sm">
          Yes, in most states — for accounts that do not already have a payable-on-death (POD) designation. Present the affidavit with a death certificate and photo ID. A bank instruction letter citing the applicable statute significantly improves cooperation.
        </div>
      </details>

      <details class="bg-[#EEE9E1] rounded-xl border border-[#D4CCC0]">
        <summary class="p-6 font-medium text-[#2D5016] cursor-pointer list-none flex items-center justify-between">
          Does a small estate affidavit work for real estate?
          <span class="text-[#8B6914] text-xl">+</span>
        </summary>
        <div class="px-6 pb-6 text-[#2C2C2A] leading-relaxed text-sm">
          It depends on the state. Arizona and Nevada allow it for real property. Texas uses an Affidavit of Heirship for real property (no threshold). Illinois does not cover real property. California does not cover real property through this mechanism — use a TOD Deed instead.
        </div>
      </details>

      <details class="bg-[#EEE9E1] rounded-xl border border-[#D4CCC0]">
        <summary class="p-6 font-medium text-[#2D5016] cursor-pointer list-none flex items-center justify-between">
          How long does a small estate affidavit take?
          <span class="text-[#8B6914] text-xl">+</span>
        </summary>
        <div class="px-6 pb-6 text-[#2C2C2A] leading-relaxed text-sm">
          The waiting period (usually 30 days) is typically the longest step. After that, completing the form takes 1–2 hours. Recording or presenting it takes a single visit or mail filing. Total time from death to asset access: as little as 5–6 weeks in straightforward cases.
        </div>
      </details>

      <details class="bg-[#EEE9E1] rounded-xl border border-[#D4CCC0]">
        <summary class="p-6 font-medium text-[#2D5016] cursor-pointer list-none flex items-center justify-between">
          Do I need a lawyer for a small estate affidavit?
          <span class="text-[#8B6914] text-xl">+</span>
        </summary>
        <div class="px-6 pb-6 text-[#2C2C2A] leading-relaxed text-sm">
          No. The process is specifically designed to be used without attorney involvement. However, if the estate is complicated — significant debts, disputed heirs, real estate in a state that requires probate — consulting an attorney is the right call.
        </div>
      </details>

      <details class="bg-[#EEE9E1] rounded-xl border border-[#D4CCC0]">
        <summary class="p-6 font-medium text-[#2D5016] cursor-pointer list-none flex items-center justify-between">
          What is the difference between a small estate affidavit and an affidavit of heirship?
          <span class="text-[#8B6914] text-xl">+</span>
        </summary>
        <div class="px-6 pb-6 text-[#2C2C2A] leading-relaxed text-sm">
          A small estate affidavit is used to collect specific assets when the estate is below a threshold — it generally requires a waiting period and is presented to asset holders. An affidavit of heirship (used primarily in Texas) establishes the identity of heirs for property succession purposes and is typically recorded with a county recorder. The two are different tools for different purposes, though they overlap in some states.
        </div>
      </details>

    </div>
  </section>

