const articleSchema = `{
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": "Illinois Small Estate Affidavit 2026: Current Law After August 2025 Amendment",
  "description": "Illinois small estate affidavit threshold is now $150,000 after August 2025 amendment. Cook County has special rules. Updated guide to 755 ILCS 5/25-1.",
  "datePublished": "2026-01-01",
  "dateModified": "2026-07-28",
  "author": {
    "@type": "Organization",
    "name": "smallestateform.com",
    "url": "https://smallestateform.com"
  },
  "publisher": {
    "@type": "Organization",
    "name": "smallestateform.com",
    "url": "https://smallestateform.com"
  }
}`;

const faqSchema = `{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What is the Illinois small estate affidavit limit in 2026?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "The statewide limit is $150,000 after the August 2025 amendment to 755 ILCS 5/25-1. Cook County has a different, lower formula: $20,000 base plus $10,000 for each surviving minor child of the deceased."
      }
    },
    {
      "@type": "Question",
      "name": "What are the Cook County small estate affidavit rules in Illinois?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Cook County uses a separate threshold formula: $20,000 plus $10,000 per surviving minor child. For example, an estate with no minor children is limited to $20,000; an estate with two minor children can be up to $40,000."
      }
    },
    {
      "@type": "Question",
      "name": "What changed in the Illinois small estate law in August 2025?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "The August 2025 amendment to 755 ILCS 5/25-1 raised the statewide small estate threshold to $150,000. Previously the limit was lower, requiring many families to go through formal probate. The amendment also updated certain procedural requirements."
      }
    },
    {
      "@type": "Question",
      "name": "How long do you have to wait to file an Illinois Small Estate Affidavit?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "You must wait at least 30 days after the date of death before presenting an Illinois Small Estate Affidavit. This waiting period is required by 755 ILCS 5/25-1 and cannot be waived."
      }
    },
    {
      "@type": "Question",
      "name": "Does an Illinois Small Estate Affidavit work for real estate?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Generally, no. Unlike some other states, Illinois's Small Estate Affidavit process does not typically cover real property transfers. Real estate in Illinois generally requires probate or another transfer instrument such as an Illinois Transfer on Death Instrument."
      }
    },
    {
      "@type": "Question",
      "name": "Can I use an Illinois Small Estate Affidavit for a bank account?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes, if the total estate value is within the applicable threshold (statewide $150,000; Cook County formula) and the account does not already have a payable-on-death designation. Present the affidavit along with a death certificate and photo ID to the bank."
      }
    }
  ]
}`;

const howToSchema = `{
  "@context": "https://schema.org",
  "@type": "HowTo",
  "name": "How to File an Illinois Small Estate Affidavit",
  "description": "Step-by-step process for using an Illinois Small Estate Affidavit under 755 ILCS 5/25-1 as amended August 2025.",
  "totalTime": "P30D",
  "step": [
    {
      "@type": "HowToStep",
      "name": "Confirm eligibility",
      "text": "Verify 30 days have elapsed since death, confirm you are an heir or legatee, and calculate the total probate estate value. If in Cook County, apply the $20,000 + $10,000/minor child formula."
    },
    {
      "@type": "HowToStep",
      "name": "Obtain the correct form",
      "text": "Use an Illinois-specific form that meets 755 ILCS 5/25-1 requirements. Ensure it reflects the August 2025 threshold and includes all required fields including the penalty-of-perjury statement."
    },
    {
      "@type": "HowToStep",
      "name": "Complete and notarize",
      "text": "Fill in all required information about the deceased, heirs, assets, and your relationship. Sign before a notary public."
    },
    {
      "@type": "HowToStep",
      "name": "Present to the asset holder",
      "text": "Bring the notarized affidavit, death certificate, and your ID to the bank, brokerage, or other institution. Include a bank instruction letter citing 755 ILCS 5/25-1 to improve acceptance rates."
    }
  ]
}`;

const breadcrumbSchema = `{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "https://smallestateform.com/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Small Estate Affidavit",
      "item": "https://smallestateform.com/small-estate-affidavit/"
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": "Illinois",
      "item": "https://smallestateform.com/small-estate-affidavit/illinois/"
    }
  ]
