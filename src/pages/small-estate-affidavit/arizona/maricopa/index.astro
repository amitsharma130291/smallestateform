  "description": "County-specific process for recording an Arizona Small Estate Affidavit for real property at the Maricopa County Recorder under ARS §14-3971 (HB2116, March 2026).",
  "totalTime": "P30D",
  "estimatedCost": {
    "@type": "MonetaryAmount",
    "currency": "USD",
    "value": "42"
  },
  "step": [
    {
      "@type": "HowToStep",
      "name": "Confirm 30-day waiting period",
      "text": "Verify that at least 30 days have passed since the date of death as shown on the death certificate."
    },
    {
      "@type": "HowToStep",
      "name": "Verify property value under $300,000",
      "text": "Confirm the fair market value of the real property is under the $300,000 threshold (HB2116, March 2026)."
    },
    {
      "@type": "HowToStep",
      "name": "Complete the Maricopa County affidavit form",
      "text": "Use Maricopa Superior Court probate division-compatible forms. Include the deceased's information, legal property description, heir information, and penalty-of-perjury statement."
    },
    {
      "@type": "HowToStep",
      "name": "Notarize the affidavit",
      "text": "Sign the completed affidavit in front of a notary public."
    },
    {
      "@type": "HowToStep",
