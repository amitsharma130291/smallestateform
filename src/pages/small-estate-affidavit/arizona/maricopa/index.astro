const faqSchema = `{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Where do I file a small estate affidavit for real property in Maricopa County, Arizona?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Record the Small Estate Affidavit with the Maricopa County Recorder at 111 S 3rd Ave, Phoenix, AZ 85003. Recording fees are $30 for the first page plus $3 for each additional page."
      }
    },
    {
      "@type": "Question",
      "name": "What are the Maricopa County small estate thresholds in 2026?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "As of March 2026 under HB2116, the thresholds are $200,000 for personal property and $300,000 for real property. A 30-day waiting period applies."
      }
    },
    {
      "@type": "Question",
      "name": "How much does it cost to record a small estate affidavit with the Maricopa County Recorder?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "The Maricopa County Recorder charges $30 for the first page and $3 for each additional page. A typical 2–4 page affidavit costs $30–$42 to record."
      }
    },
    {
      "@type": "Question",
      "name": "Can I mail my small estate affidavit to the Maricopa County Recorder?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. Mail the original notarized affidavit with payment (check payable to Maricopa County Recorder) and a self-addressed stamped envelope to 111 S 3rd Ave, Phoenix, AZ 85003."
      }
    },
    {
      "@type": "Question",
      "name": "Do I file at the Superior Court or the County Recorder in Maricopa County?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "For real property, you record with the Maricopa County Recorder (111 S 3rd Ave, Phoenix). You do not file a petition with the Superior Court — the affidavit process is designed to bypass the court entirely."
