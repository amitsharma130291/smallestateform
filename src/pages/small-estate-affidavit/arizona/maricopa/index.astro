      "name": "Home",
      "item": "https://smallestateform.com/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Small Estate Affidavit",
      "item": "https://smallestateform.com/small-estate-affidavit/"
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": "Arizona",
      "item": "https://smallestateform.com/small-estate-affidavit/arizona/"
    },
    {
      "@type": "ListItem",
      "position": 4,
      "name": "Maricopa County",
      "item": "https://smallestateform.com/small-estate-affidavit/arizona/maricopa/"
