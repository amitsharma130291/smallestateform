---
import StatePage from '../../../layouts/StatePage.astro';
import AffidavitFormApp from '../../../components/AffidavitFormApp';

const articleSchema = `{
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": "Arizona Small Estate Affidavit 2026: New HB2116 Thresholds Explained",
  "description": "Arizona raised small estate limits in March 2026 under HB2116. Personal property now $200,000, real property $300,000. Updated guide to ARS §14-3971 process.",
  "datePublished": "2026-01-01",
  "dateModified": "2026-07-28",
  "author": {
    "@type": "Organization",
    "name": "smallestateform.com",
    "url": "https://smallestateform.com"
  },
  "publisher": {
    "@type": "Organization",
    "name": "smallestateform.com",
    "url": "https://smallestateform.com"
  }
}`;

const faqSchema = `{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What are the Arizona small estate affidavit limits in 2026?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "As of March 2026, Arizona raised its small estate thresholds under HB2116. Personal property: $200,000. Real property: $300,000. These are the current limits under ARS §14-3971."
      }
    },
    {
      "@type": "Question",
      "name": "What is the waiting period for an Arizona Small Estate Affidavit?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "You must wait at least 30 days after the date of death before presenting an Arizona Small Estate Affidavit. This waiting period cannot be waived."
      }
    },
    {
      "@type": "Question",
      "name": "Does Arizona's Small Estate Affidavit work for real estate?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. Under ARS §14-3971 as amended by HB2116 (March 2026), real property valued under $300,000 can be transferred using an affidavit. The affidavit must be recorded with the county recorder, not just presented to an institution."
      }
    },
    {
      "@type": "Question",
      "name": "Do I need to go to court to use an Arizona Small Estate Affidavit?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No. The Arizona Small Estate Affidavit process under ARS §14-3971 bypasses probate court entirely. For personal property, you present the affidavit directly to the asset holder. For real property, you record it with the county recorder."
      }
    },
    {
      "@type": "Question",
      "name": "Which Arizona counties use different small estate forms?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Maricopa, Pima, and Yavapai counties use county-specific forms rather than the general state form. Maricopa County uses Maricopa Superior Court probate division forms and records with the Maricopa County Recorder."
      }
    },
    {
      "@type": "Question",
      "name": "What changed in Arizona's small estate law in March 2026?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "HB2116, signed in March 2026, significantly raised Arizona's small estate thresholds. Personal property increased to $200,000 and real property to $300,000. Many families who previously had to go through probate can now use the faster affidavit process."
      }
    }
  ]
}`;

const howToSchema = `{
  "@context": "https://schema.org",
  "@type": "HowTo",
  "name": "How to File an Arizona Small Estate Affidavit",
  "description": "Step-by-step process for claiming a deceased person's Arizona assets using a Small Estate Affidavit under ARS §14-3971 (as amended by HB2116, March 2026).",
  "totalTime": "P30D",
  "step": [
    {
      "@type": "HowToStep",
      "name": "Confirm the 30-day waiting period has elapsed",
      "text": "Verify that at least 30 days have passed since the date of death as shown on the death certificate. The affidavit cannot be used before this period."
    },
    {
      "@type": "HowToStep",
      "name": "Determine asset type and total value",
      "text": "Identify whether you are claiming personal property (limit: $200,000) or real property (limit: $300,000) and confirm the estate's total value falls within the applicable threshold."
    },
    {
      "@type": "HowToStep",
      "name": "Obtain the county-appropriate form",
      "text": "Use the form specific to your county. Maricopa, Pima, and Yavapai use county forms; other Arizona counties use the general state form."
    },
    {
      "@type": "HowToStep",
      "name": "Complete and notarize the affidavit",
      "text": "Fill in the deceased's information, your relationship, asset description, and estate value, then sign before a notary public."
    },
    {
      "@type": "HowToStep",
      "name": "Present or record",
      "text": "For personal property: present the notarized affidavit to the bank, DMV, or other asset holder along with the death certificate. For real property: record the affidavit with the county recorder in the county where the property is located."
    }
  ]
}`;

const breadcrumbSchema = `{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "https://smallestateform.com/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Small Estate Affidavit",
      "item": "https://smallestateform.com/small-estate-affidavit/"
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": "Arizona",
      "item": "https://smallestateform.com/small-estate-affidavit/arizona/"
    }
  ]
}`;
---

<StatePage
  title="Arizona Small Estate Affidavit 2026: New HB2116 Thresholds Explained"
  description="Arizona raised small estate limits in March 2026 under HB2116. Personal property now $200,000, real property $300,000. Updated guide to ARS §14-3971 process."
  canonicalUrl="https://smallestateform.com/small-estate-affidavit/arizona/"
  jsonLd={[articleSchema, faqSchema, howToSchema, breadcrumbSchema]}
>

  <!-- Law update callout (gold, at very top) -->
  <div class="bg-[#FFF8E8] border-l-4 border-[#B8860B] p-4 mb-4 max-w-4xl mx-auto mt-8">
    <strong>⚡ Updated March 2026</strong> — Arizona raised its small estate limits under HB2116. Every competitor shows the old, wrong threshold. Current limits: $200,000 personal property, $300,000 real property.
  </div>

  <!-- Featured snippet callout -->
  <div class="bg-[#F0EDE8] border-l-4 border-[#B8860B] p-6 mb-4 max-w-4xl mx-auto">
    <p class="font-medium text-[#1C1C1E] leading-relaxed">
      An Arizona Small Estate Affidavit lets heirs collect a deceased person's assets without probate under ARS §14-3971. As of March 2026, the thresholds are $200,000 for personal property and $300,000 for real property — significantly higher than what most online guides still show.
    </p>
  </div>

  <!-- E-E-A-T disclaimer -->
  <div class="bg-[#FAF8F5] border border-[#E5E0D8] rounded-lg p-4 mb-8 max-w-4xl mx-auto text-sm text-[#6B6B6B]">
    <strong class="text-[#3D3D3D]">Last updated July 2026.</strong> This information reflects ARS §14-3971 as amended by HB2116, effective March 2026. Laws may change. Consult a licensed attorney for advice specific to your situation.
  </div>

  <!-- H1 -->
  <div class="max-w-4xl mx-auto px-6 mb-8">
    <h1 class="font-serif text-4xl text-[#1C1C1E] leading-tight">
      Arizona Small Estate Affidavit: Updated March 2026 Thresholds Under HB2116
    </h1>
  </div>

  <!-- Form app -->
  <div class="max-w-4xl mx-auto px-6">
    <AffidavitFormApp
      client:load
      documentType="small-estate-affidavit"
      state="Arizona"
      eligibilityThreshold={200000}
      waitingDays={30}
      statutoryReference="ARS §14-3971 (as amended by HB2116, March 2026)"
    />
  </div>

  <!-- Body content -->
  <div class="max-w-4xl mx-auto px-6 py-12">

    <h2 class="font-serif text-2xl text-[#1C1C1E] mb-4">What Is an Arizona Small Estate Affidavit?</h2>
    <p class="text-[#3D3D3D] leading-relaxed mb-4">
      An Arizona Small Estate Affidavit is a sworn legal document that allows heirs to claim a deceased person's assets — bank accounts, vehicles, personal property, or real estate — without opening a probate case in court. It is authorized under ARS §14-3971 and can represent a significant savings in both time and cost compared to formal probate.
    </p>
    <p class="text-[#3D3D3D] leading-relaxed mb-8">
      The affidavit works by the heir(s) presenting a signed, notarized document to the asset holder (a bank, DMV, or property registrar) that states they are legally entitled to the property. The asset holder is then legally permitted — and generally obligated — to release the property to the heir.
    </p>

    <h2 class="font-serif text-2xl text-[#1C1C1E] mb-4">The 2026 Law Change: What HB2116 Actually Changed</h2>
    <div class="overflow-x-auto mb-4">
      <table class="w-full border-collapse text-sm">
        <thead>
          <tr class="bg-[#1C1C1E] text-[#FAF8F5]">
            <th class="p-3 text-left">Asset Type</th>
            <th class="p-3 text-left">New Limit (March 2026)</th>
            <th class="p-3 text-left">Prior Limit</th>
          </tr>
        </thead>
        <tbody>
          <tr class="border-b border-[#E5E0D8]">
            <td class="p-3 font-medium text-[#1C1C1E]">Personal property</td>
            <td class="p-3 text-[#B8860B] font-medium">$200,000</td>
            <td class="p-3 text-[#6B6B6B]">Lower — varies by prior year threshold</td>
          </tr>
          <tr class="border-b border-[#E5E0D8] bg-[#FAF8F5]">
            <td class="p-3 font-medium text-[#1C1C1E]">Real property</td>
            <td class="p-3 text-[#B8860B] font-medium">$300,000</td>
            <td class="p-3 text-[#6B6B6B]">Lower — varies by prior year threshold</td>
          </tr>
          <tr class="border-b border-[#E5E0D8]">
            <td class="p-3 font-medium text-[#1C1C1E]">Waiting period</td>
            <td class="p-3 text-[#3D3D3D]">30 days</td>
            <td class="p-3 text-[#3D3D3D]">30 days (unchanged)</td>
          </tr>
        </tbody>
      </table>
    </div>
    <p class="text-[#3D3D3D] leading-relaxed mb-8">
      <strong>Why this matters:</strong> A family home worth $280,000 that previously would have required a full probate proceeding can now pass through a small estate affidavit under the new real property threshold. That potentially saves thousands of dollars in probate attorney fees and months of delay.
    </p>

    <h2 class="font-serif text-2xl text-[#1C1C1E] mb-4">Who Qualifies?</h2>
    <div class="space-y-2 mb-8">
      <div class="flex items-start gap-3 p-3 bg-[#EFF7F2] rounded-lg">
        <span class="text-[#4A7C59] font-bold mt-0.5">✓</span>
        <span class="text-[#3D3D3D] text-sm">The deceased person's assets fall within the applicable threshold ($200,000 personal / $300,000 real)</span>
      </div>
      <div class="flex items-start gap-3 p-3 bg-[#EFF7F2] rounded-lg">
        <span class="text-[#4A7C59] font-bold mt-0.5">✓</span>
        <span class="text-[#3D3D3D] text-sm">At least 30 days have passed since the date of death</span>
      </div>
      <div class="flex items-start gap-3 p-3 bg-[#EFF7F2] rounded-lg">
        <span class="text-[#4A7C59] font-bold mt-0.5">✓</span>
        <span class="text-[#3D3D3D] text-sm">No probate proceeding is currently pending or has been commenced</span>
      </div>
      <div class="flex items-start gap-3 p-3 bg-[#EFF7F2] rounded-lg">
        <span class="text-[#4A7C59] font-bold mt-0.5">✓</span>
        <span class="text-[#3D3D3D] text-sm">You are an heir under Arizona intestate succession law OR the successor to the deceased's interest in the property</span>
      </div>
    </div>

    <h2 class="font-serif text-2xl text-[#1C1C1E] mb-4">Personal Property vs. Real Property: Two Different Processes</h2>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8">
      <div class="border border-[#E5E0D8] rounded-xl p-5 bg-[#FAF8F5]">
        <h3 class="font-serif text-lg text-[#1C1C1E] mb-3">Personal Property (under $200,000)</h3>
        <p class="text-[#3D3D3D] text-sm leading-relaxed mb-3">Bank accounts, vehicles, investments, household goods. Present the affidavit directly to the asset holder (bank, credit union, DMV).</p>
        <ul class="text-sm text-[#3D3D3D] space-y-1">
          <li>• 30-day wait required</li>
          <li>• Statement that no probate is pending</li>
          <li>• Notarized signature</li>
          <li>• Present to institution directly</li>
        </ul>
      </div>
      <div class="border border-[#E5E0D8] rounded-xl p-5 bg-[#FAF8F5]">
        <h3 class="font-serif text-lg text-[#1C1C1E] mb-3">Real Property (under $300,000)</h3>
        <p class="text-[#3D3D3D] text-sm leading-relaxed mb-3">Land, homes, rental properties, commercial real estate. Must be <strong>recorded with the county recorder</strong> — not just presented.</p>
        <ul class="text-sm text-[#3D3D3D] space-y-1">
          <li>• Must include legal property description</li>
          <li>• Fair market value (not assessed value)</li>
          <li>• Notarized signature</li>
          <li>• Recorded with county recorder</li>
        </ul>
      </div>
    </div>

    <h2 class="font-serif text-2xl text-[#1C1C1E] mb-4">County-Specific Differences: Maricopa, Pima, and Yavapai</h2>
    <p class="text-[#3D3D3D] leading-relaxed mb-4">Arizona law sets the statewide rules, but the forms and procedures vary by county. <strong>This is something most guides fail to mention.</strong></p>

    <div class="overflow-x-auto mb-6">
      <table class="w-full border-collapse text-sm">
        <thead>
          <tr class="bg-[#1C1C1E] text-[#FAF8F5]">
            <th class="p-3 text-left">County</th>
            <th class="p-3 text-left">Notable Difference</th>
          </tr>
        </thead>
        <tbody>
          <tr class="border-b border-[#E5E0D8]">
            <td class="p-3 font-medium text-[#1C1C1E]">Maricopa</td>
            <td class="p-3 text-[#3D3D3D]">Uses Maricopa Superior Court probate division forms for real property. Record with the Maricopa County Recorder. See our <a href="/small-estate-affidavit/arizona/maricopa/" class="text-[#B8860B] hover:underline">Maricopa County guide</a> for the specific address, fees, and process.</td>
          </tr>
          <tr class="border-b border-[#E5E0D8] bg-[#FAF8F5]">
            <td class="p-3 font-medium text-[#1C1C1E]">Pima</td>
            <td class="p-3 text-[#3D3D3D]">Uses Pima County-specific forms available through the Pima County Superior Court. The Pima County Recorder handles real property recording.</td>
          </tr>
          <tr class="border-b border-[#E5E0D8]">
            <td class="p-3 font-medium text-[#1C1C1E]">Yavapai</td>
            <td class="p-3 text-[#3D3D3D]">Uses forms from the Yavapai County Superior Court. Smaller county office — expect in-person assistance rather than online filing.</td>
          </tr>
          <tr class="border-b border-[#E5E0D8] bg-[#FAF8F5]">
            <td class="p-3 font-medium text-[#1C1C1E]">Other counties</td>
            <td class="p-3 text-[#3D3D3D]">The general ARS §14-3971 form applies. Check with the county recorder and superior court clerk before filing.</td>
          </tr>
        </tbody>
      </table>
    </div>

    <div class="bg-[#F0EDE8] border-l-4 border-[#B8860B] p-5 rounded-r-lg mb-8">
      <p class="text-[#3D3D3D] text-sm leading-relaxed">
        Filing in <strong>Maricopa County</strong>? See our detailed <a href="/small-estate-affidavit/arizona/maricopa/" class="text-[#B8860B] hover:underline font-medium">Maricopa County Small Estate Affidavit guide</a> which covers the specific Superior Court forms, the County Recorder location (111 S 3rd Ave, Phoenix), fees ($30 first page + $3/additional page), and what to bring.
      </p>
    </div>

    <h2 class="font-serif text-2xl text-[#1C1C1E] mb-4">Step-by-Step Filing Process</h2>
    <div class="space-y-4 mb-8">
      <div class="flex gap-4 p-4 bg-[#F0EDE8] rounded-lg border border-[#E5E0D8]">
        <div class="w-8 h-8 bg-[#1C1C1E] text-[#FAF8F5] rounded-full flex items-center justify-center font-serif text-sm shrink-0 mt-0.5">1</div>
        <div>
          <strong class="text-[#1C1C1E]">Confirm the waiting period</strong>
          <p class="text-[#3D3D3D] text-sm mt-1">At least 30 days must have passed since the date of death shown on the death certificate. The affidavit will be rejected if presented before this period expires.</p>
        </div>
      </div>
      <div class="flex gap-4 p-4 bg-[#F0EDE8] rounded-lg border border-[#E5E0D8]">
        <div class="w-8 h-8 bg-[#1C1C1E] text-[#FAF8F5] rounded-full flex items-center justify-center font-serif text-sm shrink-0 mt-0.5">2</div>
        <div>
          <strong class="text-[#1C1C1E]">Determine the asset type and value</strong>
          <p class="text-[#3D3D3D] text-sm mt-1">Add up personal property or real property separately. Each category evaluated against its own threshold. Personal property and real property claims are independent.</p>
        </div>
      </div>
      <div class="flex gap-4 p-4 bg-[#F0EDE8] rounded-lg border border-[#E5E0D8]">
        <div class="w-8 h-8 bg-[#1C1C1E] text-[#FAF8F5] rounded-full flex items-center justify-center font-serif text-sm shrink-0 mt-0.5">3</div>
        <div>
          <strong class="text-[#1C1C1E]">Get the correct county form</strong>
          <p class="text-[#3D3D3D] text-sm mt-1">Maricopa, Pima, and Yavapai use county-specific forms. Other counties use the general state form from azcourts.gov. smallestateform.com auto-selects the correct form based on your county.</p>
        </div>
      </div>
      <div class="flex gap-4 p-4 bg-[#F0EDE8] rounded-lg border border-[#E5E0D8]">
        <div class="w-8 h-8 bg-[#1C1C1E] text-[#FAF8F5] rounded-full flex items-center justify-center font-serif text-sm shrink-0 mt-0.5">4</div>
        <div>
          <strong class="text-[#1C1C1E]">Complete and notarize</strong>
          <p class="text-[#3D3D3D] text-sm mt-1">Fill in all information about the deceased, your relationship, asset description, and estate value. Sign before a notary public.</p>
        </div>
      </div>
      <div class="flex gap-4 p-4 bg-[#F0EDE8] rounded-lg border border-[#E5E0D8]">
        <div class="w-8 h-8 bg-[#1C1C1E] text-[#FAF8F5] rounded-full flex items-center justify-center font-serif text-sm shrink-0 mt-0.5">5</div>
        <div>
          <strong class="text-[#1C1C1E]">Present or record</strong>
          <p class="text-[#3D3D3D] text-sm mt-1"><strong>Personal property:</strong> Present to the bank, DMV, or brokerage along with the death certificate and your ID. <strong>Real property:</strong> Record with the county recorder in the county where the property is located.</p>
        </div>
      </div>
    </div>

  </div>

  <!-- FAQ -->
  <section class="max-w-4xl mx-auto px-6 pb-16">
    <h2 class="font-serif text-2xl text-[#1C1C1E] mb-8">Frequently asked questions</h2>
    <div class="space-y-4">

      <details class="bg-[#F0EDE8] rounded-xl border border-[#E5E0D8]">
        <summary class="p-6 font-medium text-[#1C1C1E] cursor-pointer list-none flex items-center justify-between">
          What are the Arizona small estate affidavit limits in 2026?
          <span class="text-[#B8860B] text-xl">+</span>
        </summary>
        <div class="px-6 pb-6 text-[#3D3D3D] leading-relaxed text-sm">
          As of March 2026, Arizona raised its small estate thresholds under HB2116. Personal property: $200,000. Real property: $300,000. These are the current limits under ARS §14-3971. If a guide you've found shows lower numbers, it is outdated.
        </div>
      </details>

      <details class="bg-[#F0EDE8] rounded-xl border border-[#E5E0D8]">
        <summary class="p-6 font-medium text-[#1C1C1E] cursor-pointer list-none flex items-center justify-between">
          What assets are covered by the $200,000 personal property threshold?
          <span class="text-[#B8860B] text-xl">+</span>
        </summary>
        <div class="px-6 pb-6 text-[#3D3D3D] leading-relaxed text-sm">
          Bank accounts, savings accounts, CDs, investment accounts, vehicles, household goods, jewelry, and other personal assets. Life insurance proceeds and retirement accounts with named beneficiaries generally pass outside of the estate and do not count.
        </div>
      </details>

      <details class="bg-[#F0EDE8] rounded-xl border border-[#E5E0D8]">
        <summary class="p-6 font-medium text-[#1C1C1E] cursor-pointer list-none flex items-center justify-between">
          How does the 30-day waiting period work?
          <span class="text-[#B8860B] text-xl">+</span>
        </summary>
        <div class="px-6 pb-6 text-[#3D3D3D] leading-relaxed text-sm">
          You must wait 30 full days from the date listed on the death certificate. If the date of death was July 1, the earliest you can present the affidavit is July 31. This period cannot be waived in Arizona.
        </div>
      </details>

      <details class="bg-[#F0EDE8] rounded-xl border border-[#E5E0D8]">
        <summary class="p-6 font-medium text-[#1C1C1E] cursor-pointer list-none flex items-center justify-between">
          Can an Arizona Small Estate Affidavit be used for real property?
          <span class="text-[#B8860B] text-xl">+</span>
        </summary>
        <div class="px-6 pb-6 text-[#3D3D3D] leading-relaxed text-sm">
          Yes — and this is one of Arizona's more permissive features. Under ARS §14-3971 as amended by HB2116, real property valued under $300,000 can be transferred by affidavit. The affidavit must be recorded with the county recorder, not just presented to an institution.
        </div>
      </details>

      <details class="bg-[#F0EDE8] rounded-xl border border-[#E5E0D8]">
        <summary class="p-6 font-medium text-[#1C1C1E] cursor-pointer list-none flex items-center justify-between">
          Do you need an attorney to file an Arizona Small Estate Affidavit?
          <span class="text-[#B8860B] text-xl">+</span>
        </summary>
        <div class="px-6 pb-6 text-[#3D3D3D] leading-relaxed text-sm">
          No. The process is designed to be done without an attorney. However, if there are disputes among heirs, debts that complicate the estate, or the property exceeds the thresholds, an attorney's guidance is advisable.
        </div>
      </details>

    </div>
  </section>

  <!-- Internal links -->
  <div class="max-w-4xl mx-auto px-6 pb-12 text-sm text-[#6B6B6B]">
    Related: <a href="/small-estate-affidavit/arizona/maricopa/" class="text-[#B8860B] hover:underline">Maricopa County Guide</a> | <a href="/small-estate-affidavit/" class="text-[#B8860B] hover:underline">Small Estate Affidavit Hub</a> | <a href="/" class="text-[#B8860B] hover:underline">Homepage</a>
  </div>

</StatePage>
