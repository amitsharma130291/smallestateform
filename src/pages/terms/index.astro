---
export const prerender = true;
import StatePage from '../../layouts/StatePage.astro';
---
<StatePage
  title="Terms of Service | Small Estate Form"
  description="Terms of Service for SmallEstateForm.com. Understand your rights and responsibilities when using our estate document generator."
  canonicalUrl="https://smallestateform.com/terms/"
>
  <!-- Hero / breadcrumb -->
  <section style="padding:4rem 1.5rem;background:#F7F4EF;border-bottom:1px solid #D4CCC0;">
    <div style="max-width:720px;margin:0 auto;">
      <p style="font-size:0.8rem;color:#6B6560;font-family:'DM Sans',sans-serif;margin-bottom:0.75rem;">
        <a href="/" style="color:#8B6914;text-decoration:none;">Home</a> › Terms of Service
      </p>
      <h1 style="font-family:'Cormorant Garamond',Georgia,serif;font-style:italic;font-size:clamp(2rem,4vw,2.8rem);color:#1C1C1E;margin-bottom:1rem;">Terms of Service</h1>
      <p style="font-family:'DM Sans',sans-serif;font-size:0.875rem;color:#6B6560;">Last updated: July 2025</p>
    </div>
  </section>

  <!-- Body -->
